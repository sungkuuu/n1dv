# ---------------------------------------------------------------------------
# Enzyme Finance Subgraph (n1dv vault data)
# ---------------------------------------------------------------------------
# Vault address. Replace with your Enzyme vault contract address (e.g. on Base).
VITE_ENZYME_VAULT_ADDRESS=YOUR_ENZYME_VAULT_ADDRESS

# Vault Balances Subgraph URL (required for TVL & portfolio).
# Base: deploy or use a hosted vault-balances subgraph; see docs below.
# Example (Ethereum): https://gateway.thegraph.com/api/<API_KEY>/subgraphs/id/HwR7jTExHWNvQetTxRYEMQ5hywHyUkierAYvnGS7pBUS
VITE_ENZYME_VAULT_BALANCES_SUBGRAPH_URL=

# Vault Shares Subgraph URL (optional; for share price / NAV).
# Example (Ethereum): https://gateway.thegraph.com/api/<API_KEY>/subgraphs/id/6p2L2gQ4Hw4Dh2kxZFDJbcqtbv44vrJbrBEh3EjS7qVo
VITE_ENZYME_VAULT_SHARES_SUBGRAPH_URL=

# Link for "Enter Vault" / "Invest Now" buttons. Defaults to BaseScan vault address.
# VITE_VAULT_APP_URL=https://app.enzyme.finance/vault/...

# ---------------------------------------------------------------------------
# Existing
# ---------------------------------------------------------------------------
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
